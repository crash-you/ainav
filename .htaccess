# AINAV.ART - 高级SEO和性能优化配置
# 确保Apache服务器正确处理网站请求和优化

# ==========================================
# 1. 安全性设置
# ==========================================

# 隐藏Apache版本信息
ServerTokens Prod
ServerSignature Off

# 防止访问敏感文件
<Files ~ "^\.">
    Order allow,deny
    Deny from all
</Files>

# 保护重要配置文件
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|inc|bak)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ==========================================
# 2. HTTPS重定向和安全头
# ==========================================

# 强制HTTPS重定向
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 安全头设置
<IfModule mod_headers.c>
    # HSTS - 强制HTTPS
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # 防止XSS攻击
    Header always set X-XSS-Protection "1; mode=block"
    
    # 防止MIME类型嗅探
    Header always set X-Content-Type-Options "nosniff"
    
    # 防止点击劫持
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # 推荐人政策
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # 权限政策
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ==========================================
# 3. 缓存优化
# ==========================================

<IfModule mod_expires.c>
    ExpiresActive On
    
    # HTML文件 - 短期缓存
    ExpiresByType text/html "access plus 1 hour"
    
    # CSS和JavaScript - 长期缓存
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # 图片文件 - 长期缓存
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    
    # 字体文件 - 长期缓存
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    
    # 其他资源
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType text/xml "access plus 1 hour"
    ExpiresByType application/xml "access plus 1 hour"
    ExpiresByType application/json "access plus 1 hour"
</IfModule>

# 缓存控制头
<IfModule mod_headers.c>
    # HTML文件 - 允许缓存但需验证
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
    
    # 静态资源 - 长期缓存
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ==========================================
# 4. 压缩优化
# ==========================================

<IfModule mod_deflate.c>
    # 启用压缩
    SetOutputFilter DEFLATE
    
    # 压缩文本文件
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    
    # 排除已压缩文件
    SetEnvIfNoCase Request_URI \
        \.(?:gif|jpe?g|png|zip|gz|bz2|sit|rar)$ no-gzip dont-vary
    SetEnvIfNoCase Request_URI \
        \.(?:exe|t?gz|zip|bz2|sit|rar)$ no-gzip dont-vary
</IfModule>

# ==========================================
# 5. SEO友好的URL重写
# ==========================================

RewriteEngine On

# 移除尾部斜杠（除了根目录）
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 强制小写URL
RewriteMap lc int:tolower
RewriteCond %{REQUEST_URI} [A-Z]
RewriteRule (.*) ${lc:$1} [R=301,L]

# 默认语言重定向（可选）
# RewriteCond %{HTTP_ACCEPT_LANGUAGE} ^zh [NC]
# RewriteRule ^$ /cn/ [R=302,L]

# 处理HTML扩展名（可选 - 如果想隐藏.html扩展名）
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteCond %{REQUEST_FILENAME} !-f
# RewriteRule ^([^\.]+)$ $1.html [NC,L]

# ==========================================
# 6. 错误页面
# ==========================================

ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /404.html

# ==========================================
# 7. MIME类型设置
# ==========================================

<IfModule mod_mime.c>
    # 字体文件
    AddType font/woff .woff
    AddType font/woff2 .woff2
    AddType application/font-woff .woff
    AddType application/font-woff2 .woff2
    
    # 现代图片格式
    AddType image/webp .webp
    AddType image/avif .avif
    
    # 其他文件类型
    AddType application/json .json
    AddType application/ld+json .jsonld
    AddType text/xml .xml
    AddType application/xml .xml
</IfModule>

# ==========================================
# 8. 性能优化
# ==========================================

# 启用KeepAlive
<IfModule mod_headers.c>
    Header set Connection keep-alive
</IfModule>

# 文件ETag设置
<IfModule mod_headers.c>
    # 移除ETag（因为我们使用了Expires头）
    Header unset ETag
</IfModule>
FileETag None

# ==========================================
# 9. 搜索引擎优化
# ==========================================

# 确保robots.txt和sitemap.xml可访问
<Files "robots.txt">
    Order Allow,Deny
    Allow from all
</Files>

<Files "sitemap.xml">
    Order Allow,Deny
    Allow from all
</Files>

# 为sitemap设置正确的MIME类型
<Files "sitemap.xml">
    ForceType application/xml
</Files>

# ==========================================
# 10. 特殊文件处理
# ==========================================

# ads.txt文件处理
<Files "ads.txt">
    ForceType text/plain
    Header set Cache-Control "public, max-age=86400"
</Files>

# 确保CSS和JS文件正确的MIME类型
<FilesMatch "\.css$">
    ForceType text/css
</FilesMatch>

<FilesMatch "\.js$">
    ForceType application/javascript
</FilesMatch>

# ==========================================
# 11. 防盗链保护（可选）
# ==========================================

# 保护图片资源（如果需要的话）
# RewriteCond %{HTTP_REFERER} !^$
# RewriteCond %{HTTP_REFERER} !^https?://(www\.)?ainav\.art [NC]
# RewriteRule \.(jpg|jpeg|png|gif|svg)$ - [F]

# ==========================================
# 12. 访问日志优化
# ==========================================

# 减少不必要的日志记录
SetEnvIf Request_URI "\.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2)$" dontlog
CustomLog logs/access.log combined env=!dontlog
